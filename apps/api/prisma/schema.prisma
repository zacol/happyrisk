generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────

enum UserRole {
  USER
  ADMIN
}

enum ProjectRole {
  MEMBER
  LEADER
}

enum SurveyFrequency {
  WEEKLY
  BIWEEKLY
}

enum SurveyCycleStatus {
  ACTIVE
  COMPLETED
}

enum ParticipationStatus {
  PENDING
  QUEUED
  SENT
  RESPONDED
  EXPIRED
}

enum ConversationStatus {
  PARTIAL
  COMPLETE
}

enum Sentiment {
  POSITIVE
  NEUTRAL
  NEGATIVE
}

enum FeedbackCategory {
  WORKLOAD
  COMMUNICATION
  MANAGEMENT
  MEETINGS
  PRIORITIES
  TOOLING
  TEAM_ATMOSPHERE
}

enum RiskProbability {
  LOW
  MEDIUM
  HIGH
}

enum RiskImpact {
  LOW
  MEDIUM
  HIGH
}

enum RiskStatus {
  PENDING
  ACTIVE
  MITIGATED
  RESOLVED
  DISMISSED
}

enum RiskSource {
  AI_GENERATED
  MANUAL
}

enum RiskTriggerType {
  HI_BELOW_THRESHOLD
  HI_DROP_20_PERCENT
}

enum RiskActionType {
  REVIEWED
  ADDRESSED
  DISMISSED
}

// ─────────────────────────────────────────────
// Auth & Identity
// ─────────────────────────────────────────────

model User {
  id       String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email    String   @unique @db.VarChar(255)
  name     String?  @db.VarChar(255)
  image    String?
  role     UserRole @default(USER)
  isActive Boolean  @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  oauthAccounts        OAuthAccount[]
  refreshTokens        RefreshToken[]
  teamMemberships      TeamMembership[]
  projectMemberships   ProjectMembership[]
  surveyParticipations SurveyParticipation[]
  createdRisks         Risk[]                @relation("RiskCreatedBy")
  riskActions          RiskAction[]

  @@index([email])
  @@map("users")
}

model OAuthAccount {
  id                String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String @map("user_id") @db.Uuid
  provider          String @db.VarChar(50)
  providerAccountId String @map("provider_account_id") @db.VarChar(255)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("oauth_accounts")
}

model RefreshToken {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  hashedToken String   @unique @map("hashed_token")
  expiresAt   DateTime @map("expires_at") @db.Timestamptz
  revoked     Boolean  @default(false)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([hashedToken])
  @@map("refresh_tokens")
}

// ─────────────────────────────────────────────
// Organization: Team & Project
// ─────────────────────────────────────────────

model Team {
  id                String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name              String  @db.VarChar(255)
  departmentSegment String? @map("department_segment") @db.VarChar(100)
  isActive          Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  memberships TeamMembership[]

  @@map("teams")
}

model TeamMembership {
  id       String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId   String   @map("user_id") @db.Uuid
  teamId   String   @map("team_id") @db.Uuid
  joinedAt DateTime @default(now()) @map("joined_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  team Team @relation(fields: [teamId], references: [id], onDelete: Restrict)

  @@unique([userId, teamId])
  @@index([teamId])
  @@map("team_memberships")
}

model Project {
  id               String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name             String  @db.VarChar(255)
  slackWorkspaceId String? @unique @map("slack_workspace_id") @db.VarChar(64)
  isActive         Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  memberships        ProjectMembership[]
  surveyConfig       SurveyConfig?
  surveyCycles       SurveyCycle[]
  surveyResponses    SurveyResponse[]
  risks              Risk[]
  happinessSnapshots HappinessSnapshot[]
  thematicSummaries  ThematicSummary[]

  @@map("projects")
}

model ProjectMembership {
  id          String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String      @map("user_id") @db.Uuid
  projectId   String      @map("project_id") @db.Uuid
  slackUserId String?     @map("slack_user_id") @db.VarChar(64)
  projectRole ProjectRole @default(MEMBER) @map("project_role")
  assignedAt  DateTime    @default(now()) @map("assigned_at") @db.Timestamptz

  user    User    @relation(fields: [userId], references: [id], onDelete: Restrict)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([userId, projectId])
  @@unique([projectId, slackUserId])
  @@index([projectId])
  @@map("project_memberships")
}

// ─────────────────────────────────────────────
// Survey Domain
// ─────────────────────────────────────────────

model SurveyConfig {
  id        String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId String          @unique @map("project_id") @db.Uuid
  frequency SurveyFrequency @default(WEEKLY)
  dayOfWeek Int             @default(5) @map("day_of_week") @db.SmallInt
  timeUtc   String          @default("14:00") @map("time_utc") @db.VarChar(5)
  isActive  Boolean         @default(true) @map("is_active")

  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  project Project @relation(fields: [projectId], references: [id], onDelete: Restrict)

  @@map("survey_configs")
}

model SurveyCycle {
  id          String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId   String            @map("project_id") @db.Uuid
  periodStart DateTime          @map("period_start") @db.Date
  periodEnd   DateTime          @map("period_end") @db.Date
  status      SurveyCycleStatus @default(ACTIVE)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  project        Project               @relation(fields: [projectId], references: [id], onDelete: Restrict)
  participations SurveyParticipation[]
  responses      SurveyResponse[]
  snapshots      HappinessSnapshot[]
  summaries      ThematicSummary[]

  @@index([projectId])
  @@index([projectId, periodStart])
  @@map("survey_cycles")
}

/// ⚠️ Anonymity Boundary: tracks WHO was invited — no content stored.
model SurveyParticipation {
  id            String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String              @map("user_id") @db.Uuid
  surveyCycleId String              @map("survey_cycle_id") @db.Uuid
  status        ParticipationStatus @default(PENDING)
  sentAt        DateTime?           @map("sent_at") @db.Timestamptz
  respondedAt   DateTime?           @map("responded_at") @db.Timestamptz

  user        User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  surveyCycle SurveyCycle @relation(fields: [surveyCycleId], references: [id], onDelete: Restrict)

  @@unique([userId, surveyCycleId])
  @@index([surveyCycleId])
  @@map("survey_participations")
}

/// ⚠️ Anonymity Boundary: stores WHAT was said — no user_id.
/// created_at uses DATE precision (not TIMESTAMPTZ) to prevent de-anonymization.
model SurveyResponse {
  id                 String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  surveyCycleId      String             @map("survey_cycle_id") @db.Uuid
  projectId          String             @map("project_id") @db.Uuid
  rating             Int                @db.SmallInt
  initialComment     String?            @map("initial_comment")
  followUpQuestion   String?            @map("follow_up_question")
  followUpAnswer     String?            @map("follow_up_answer")
  conversationStatus ConversationStatus @default(PARTIAL) @map("conversation_status")

  createdAt DateTime @default(now()) @map("created_at") @db.Date

  surveyCycle SurveyCycle @relation(fields: [surveyCycleId], references: [id], onDelete: Restrict)
  project     Project     @relation(fields: [projectId], references: [id], onDelete: Restrict)
  aiAnalysis  AIAnalysis?

  @@index([surveyCycleId])
  @@index([projectId])
  @@index([projectId, createdAt])
  @@map("survey_responses")
}

// ─────────────────────────────────────────────
// AI & Analytics
// ─────────────────────────────────────────────

model AIAnalysis {
  id                String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  surveyResponseId  String           @unique @map("survey_response_id") @db.Uuid
  sentiment         Sentiment
  category          FeedbackCategory
  coreIssue         String           @map("core_issue") @db.VarChar(100)
  isProjectRisk     Boolean          @default(false) @map("is_project_risk")
  riskJustification String?          @map("risk_justification")
  suggestion        String?
  rawJson           Json?            @map("raw_json") @db.JsonB

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  surveyResponse SurveyResponse @relation(fields: [surveyResponseId], references: [id], onDelete: Restrict)
  risk           Risk?

  @@index([sentiment])
  @@index([category])
  @@index([category, sentiment])
  @@map("ai_analyses")
}

model HappinessSnapshot {
  id                String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId         String  @map("project_id") @db.Uuid
  surveyCycleId     String  @map("survey_cycle_id") @db.Uuid
  averageRating     Decimal @map("average_rating") @db.Decimal(3, 2)
  responseCount     Int     @map("response_count") @db.SmallInt
  responseRate      Decimal @map("response_rate") @db.Decimal(5, 2)
  categoryBreakdown Json?   @map("category_breakdown") @db.JsonB

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  project     Project     @relation(fields: [projectId], references: [id], onDelete: Restrict)
  surveyCycle SurveyCycle @relation(fields: [surveyCycleId], references: [id], onDelete: Restrict)

  @@unique([projectId, surveyCycleId])
  @@index([projectId])
  @@index([projectId, createdAt])
  @@map("happiness_snapshots")
}

// ─────────────────────────────────────────────
// Risk Management
// ─────────────────────────────────────────────

model Risk {
  id           String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId    String           @map("project_id") @db.Uuid
  title        String           @db.VarChar(255)
  description  String?
  category     FeedbackCategory
  probability  RiskProbability  @default(MEDIUM)
  impact       RiskImpact       @default(MEDIUM)
  status       RiskStatus       @default(PENDING)
  source       RiskSource       @default(AI_GENERATED)
  triggerType  RiskTriggerType? @map("trigger_type")
  aiAnalysisId String?          @unique @map("ai_analysis_id") @db.Uuid
  createdById  String?          @map("created_by_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  project    Project      @relation(fields: [projectId], references: [id], onDelete: Restrict)
  aiAnalysis AIAnalysis?  @relation(fields: [aiAnalysisId], references: [id], onDelete: Restrict)
  createdBy  User?        @relation("RiskCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  actions    RiskAction[]

  @@index([projectId])
  @@index([status])
  @@index([projectId, status])
  @@map("risks")
}

model RiskAction {
  id               String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  riskId           String         @map("risk_id") @db.Uuid
  performedById    String         @map("performed_by_id") @db.Uuid
  actionType       RiskActionType @map("action_type")
  comment          String?
  notificationSent Boolean        @default(false) @map("notification_sent")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  risk        Risk @relation(fields: [riskId], references: [id], onDelete: Restrict)
  performedBy User @relation(fields: [performedById], references: [id], onDelete: Restrict)

  @@index([riskId])
  @@map("risk_actions")
}

// ─────────────────────────────────────────────
// Privacy: Thematic Summaries (n < 5)
// ─────────────────────────────────────────────

model ThematicSummary {
  id            String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId     String @map("project_id") @db.Uuid
  surveyCycleId String @map("survey_cycle_id") @db.Uuid
  summaryText   String @map("summary_text")
  responseCount Int    @map("response_count") @db.SmallInt

  generatedAt DateTime @default(now()) @map("generated_at") @db.Timestamptz

  project     Project     @relation(fields: [projectId], references: [id], onDelete: Restrict)
  surveyCycle SurveyCycle @relation(fields: [surveyCycleId], references: [id], onDelete: Restrict)

  @@unique([projectId, surveyCycleId])
  @@map("thematic_summaries")
}
